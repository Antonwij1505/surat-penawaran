<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_send_wa_wizard_form" model="ir.ui.view">
        <field name="name">send.wa.wizard.form</field>
        <field name="model">send.wa.wizard</field>
        <field name="arch" type="xml">
            <form string="Kirim WhatsApp (Click to Chat)">
                <sheet>
                    <div class="alert alert-success py-2 mb-3" role="alert">
                        <strong>🔒 Aman &amp; Resmi (Click to Chat):</strong> Pesan akan langsung dibuka di <strong>WhatsApp Web / Aplikasi WhatsApp</strong> nomor Anda sendiri secara resmi via <code>wa.me</code> (100% aman tanpa risiko banned). Anda dapat memeriksa/mengedit teks pesan di bawah sebelum dikirim.
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <group string="Tujuan Pengiriman" class="mb-0">
                                <field name="doc_model" invisible="1"/>
                                <field name="doc_id" invisible="1"/>
                                <field name="doc_name" readonly="1" string="Dokumen"/>
                                <field name="partner_id" string="Instansi / Customer"/>
                            </group>
                        </div>
                        <div class="col-6">
                            <group string="Kontak Penerima" class="mb-0">
                                <field name="recipient_name" string="Nama PIC"/>
                                <field name="recipient_phone" string="No. WhatsApp / HP"/>
                            </group>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label for="message" string="Teks Pesan WhatsApp (Dapat Diedit)" class="fw-bold mb-1"/>
                        <field name="message" class="w-100" style="width: 100% !important; min-height: 180px; font-family: inherit; font-size: 13px;" placeholder="Tuliskan pesan WhatsApp di sini..."/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_send" string="💬 Buka WhatsApp (Click to Chat)" type="object" class="btn-success" icon="fa-whatsapp"/>
                    <button name="action_download_pdf" string="📥 Download PDF Dokumen" type="object" class="btn-outline-primary" icon="fa-download"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
