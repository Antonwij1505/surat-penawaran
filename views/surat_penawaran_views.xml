<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_surat_penawaran_form" model="ir.ui.view">
        <field name="name">surat.penawaran.form</field>
        <field name="model">surat.penawaran</field>
        <field name="arch" type="xml">
            <form string="Surat Penawaran">
                <header>
                    <button name="action_send_whatsapp" type="object" string="💬 Kirim WA" class="btn-success" icon="fa-whatsapp"/>
                    <button name="action_send_email" type="object" string="✉️ Kirim Email" class="btn-primary" icon="fa-envelope"/>
                    <button name="action_print" type="object" string="Cetak PDF" class="btn-secondary" icon="fa-print"/>
                    <button name="action_create_customer_po" type="object" string="🛒 Buat Form PO" class="btn-outline-primary" icon="fa-shopping-cart"/>
                    <button name="action_send" type="object" string="Tandai Terkirim" class="btn-secondary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_accept" type="object" string="Diterima" class="btn-success" attrs="{'invisible': [('state', '!=', 'sent')]}"/>
                    <button name="action_refuse" type="object" string="Ditolak" class="btn-danger" attrs="{'invisible': [('state', '!=', 'sent')]}"/>
                    <button name="action_reset_to_draft" type="object" string="Reset ke Draft" class="btn-secondary" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,accepted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Terkirim" bg_color="bg-info" attrs="{'invisible': [('state', '!=', 'sent')]}"/>
                    <widget name="web_ribbon" title="Diterima" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'accepted')]}"/>
                    <widget name="web_ribbon" title="Ditolak" bg_color="bg-danger" attrs="{'invisible': [('state', '!=', 'refused')]}"/>
                    <div class="oe_title">
                        <label for="name" string="Nomor Penawaran"/>
                        <h1>
                            <field name="name" class="text-primary" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Utama">
                            <field name="company_entity" widget="radio" options="{'horizontal': true}"/>
                            <field name="partner_id" widget="res_partner_many2one" context="{'show_address': 1}" options="{'always_reload': True}" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                            <field name="user_id" widget="many2one_avatar_user" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group string="Periode &amp; Tanggal">
                            <field name="date_order" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                            <field name="validity_date" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detail Produk" name="lines">
                            <field name="line_ids" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}">
                                <tree editable="bottom" decoration-bf="discount &gt; 0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty" string="Qty"/>
                                    <field name="product_uom" string="Satuan" force_save="1"/>
                                    <field name="unit_price" string="Harga Satuan" widget="monetary"/>
                                    <field name="discount" string="Disc (%)"/>
                                    <field name="tax_ids" string="Pajak" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="price_subtotal" string="Subtotal" widget="monetary"/>
                                    <field name="price_tax" string="Pajak" widget="monetary" optional="hide"/>
                                    <field name="price_total" string="Total" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id" required="1"/>
                                            <field name="name"/>
                                            <field name="product_uom_qty"/>
                                            <field name="product_uom"/>
                                        </group>
                                        <group>
                                            <field name="unit_price"/>
                                            <field name="discount"/>
                                            <field name="tax_ids" widget="many2many_tags"/>
                                            <field name="price_subtotal"/>
                                            <field name="price_tax"/>
                                            <field name="price_total"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>

                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group colspan="4" string="Catatan / Syarat &amp; Ketentuan">
                                    <field name="notes" string="Poin 1, 2, 3 (Standar)" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}" class="text-muted mb-2"/>
                                    <field name="notes_extra" string="Catatan Tambahan (Poin 4)" placeholder="Ketik keterangan tambahan untuk poin ke-4 di sini (contoh: Garansi produk 1 tahun, Franco gudang pembeli, dll)..." attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                                </group>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="surat_penawaran_total">
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="amount_total"/>
                                    </div>
                                    <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                                <div class="clearfix"/>
                            </group>
                        </page>

                        <page string="Detail PIC" name="pic_detail">
                            <group>
                                <group>
                                    <field name="pic_name" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                                    <field name="pic_position" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                                </group>
                                <group>
                                    <field name="pic_email" widget="email" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                                    <field name="pic_phone" widget="phone" attrs="{'readonly': [('state', 'in', ('accepted', 'refused'))]}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_surat_penawaran_tree" model="ir.ui.view">
        <field name="name">surat.penawaran.tree</field>
        <field name="model">surat.penawaran</field>
        <field name="arch" type="xml">
            <tree string="Surat Penawaran" decoration-info="state == 'sent'" decoration-success="state == 'accepted'" decoration-muted="state == 'refused'">
                <field name="name" string="No. Penawaran"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="pic_name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="validity_date"/>
                <field name="amount_untaxed" widget="monetary" optional="show"/>
                <field name="amount_total" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'sent'" decoration-success="state == 'accepted'" decoration-danger="state == 'refused'"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_surat_penawaran_search" model="ir.ui.view">
        <field name="name">surat.penawaran.search</field>
        <field name="model">surat.penawaran</field>
        <field name="arch" type="xml">
            <search string="Surat Penawaran">
                <field name="name" string="Nomor Penawaran"/>
                <field name="partner_id" string="Customer"/>
                <field name="pic_name" string="Nama PIC"/>
                <field name="user_id" string="Salesperson"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Terkirim" name="sent" domain="[('state','=','sent')]"/>
                <filter string="Diterima" name="accepted" domain="[('state','=','accepted')]"/>
                <filter string="Ditolak" name="refused" domain="[('state','=','refused')]"/>
                <separator/>
                <filter string="Penawaran Saya" name="my_quotations" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="user_id" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="partner_id" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="date_order" string="Tanggal Surat" context="{'group_by': 'date_order'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_surat_penawaran_pivot" model="ir.ui.view">
        <field name="name">surat.penawaran.pivot</field>
        <field name="model">surat.penawaran</field>
        <field name="arch" type="xml">
            <pivot string="Analisis Surat Penawaran">
                <field name="state" type="row"/>
                <field name="user_id" type="row"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_surat_penawaran_kanban" model="ir.ui.view">
        <field name="name">surat.penawaran.kanban</field>
        <field name="model">surat.penawaran</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top mb4">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <strong>
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-user me-1 text-muted"/> <field name="partner_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt4">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <field name="date_order"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_surat_penawaran" model="ir.actions.act_window">
        <field name="name">Surat Penawaran</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">surat.penawaran</field>
        <field name="view_mode">tree,kanban,form,pivot</field>
        <field name="search_view_id" ref="view_surat_penawaran_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat surat penawaran pertama Anda!
            </p>
        </field>
    </record>

    <menuitem id="menu_surat_penawaran_root"
              name="Surat Penawaran"
              sequence="25"/>

    <menuitem id="menu_surat_penawaran_action"
              name="Daftar Penawaran"
              parent="menu_surat_penawaran_root"
              action="action_surat_penawaran"
              sequence="10"/>

    <!-- Shortcut Menu under Sales module if available -->
    <menuitem id="menu_surat_penawaran_sale_sub"
              name="Surat Penawaran (SPH)"
              parent="sale.sale_order_menu"
              action="action_surat_penawaran"
              sequence="5"/>
</odoo>
